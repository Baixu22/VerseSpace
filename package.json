{
	"name": "versespace",
	"description": "The local-first IDE for coding agent orchestration.",
	"private": true,
	"version": "0.46.0",
	"packageManager": "bun@1.3.14",
	"type": "module",
	"workspaces": [
		".",
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"prepare": "husky",
		"typecheck": "cd packages/workbench && bunx tsc --noEmit && cd ../context-rot && bunx tsc --noEmit && cd ../../apps/workbench-ui && bunx tsc --noEmit",
		"lint": "biome check . --config-path=./biome.json",
		"lint:fix": "biome check . --write --config-path=./biome.json",
		"test": "bun run test:workbench && bun run test:workbench-ui && bun run test:context-rot",
		"test:workbench": "cd packages/workbench && bun run test",
		"test:workbench-ui": "cd apps/workbench-ui && vitest run",
		"test:context-rot": "cd packages/context-rot && bun run test",
		"check:upload-surface": "node scripts/check-upload-surface.mjs",
		"test:upload-surface": "node scripts/upload-surface/classify.test.mjs && node scripts/upload-surface/links.test.mjs",
		"check:claims": "node scripts/check-claims.mjs",
		"test:claims": "node scripts/claims/ledger.test.mjs",
		"audit:catch-sites": "node scripts/audit/catch-sites.mjs",
		"dev:ui": "cd apps/workbench-ui && bun run dev",
		"build:ui": "cd packages/workbench && bun run scripts/ui-prepare.ts",
		"icons": "node scripts/gen-icon-layer.mjs",
		"release:tag:workbench": "node scripts/tag-workbench-release.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"reicon-mcp": "^1.1.102"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css}": [
			"biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true --config-path=./biome.json"
		]
	},
	"trustedDependencies": [
		"esbuild",
		"playwright",
		"@parcel/watcher",
		"husky"
	]
}
