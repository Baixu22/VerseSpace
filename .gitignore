# Raw chrome-devtools traces are ~250MB each; keep them local.
# The aggregated *-trace-summary.json is small and IS committed.
docs/perf/*-trace-workspace-*.json
docs/perf/*-trace-session-*.json
docs/perf/*-trace-streaming-*.json
docs/perf/*-trace-confirm*.json
docs/perf/iter*-after-switch.png
# Per-goal diagnostic traces — exclude anything that ends in -trace.json.
# phase1-trace-summary.json and iter*-trace-summary.json are small and
# whitelisted above the broader pattern.
docs/perf/*-trace.json
docs/perf/goal*-style-*.json

*storybook.log
storybook-static

# Playwright E2E artifacts (HTML report + per-test traces/videos)
playwright-report/
test-results/
test-results-*/
# Local browser/debug evidence and nested live-run copies; curated root evidence
# is added explicitly when it belongs in a stage-D commit.
/.agent-contexts/*-e2e-*/
# Live-model E2E evidence sites (2026-09-11): the .workbench blackboard, temp
# git repo and agent transcripts inside are local machine state — they are for
# human review, not for version control. The curated readings from a site live
# in docs/ reports and the task-forest node evidence, not in the raw dump.
packages/workbench/.evidence-sites/
# session scratch dirs (proposal drafts + evidence builders already landed in
# task-forest/proposals/ and docs/); kept local only
/.agent-contexts/empty-retry/
/.agent-contexts/full-chain/
/.agent-contexts/goal-check/
/.agent-contexts/live-model-2026-09-07/
/.agent-contexts/phase-d-2026-09-07/
/.agent-contexts/phase-d-quota-2026-09-08/
/.agent-contexts/s6c-2026-09-08/
# root-level proposed-before-apply drafts; the applied copies live in
# .agent-workbench/task-forest/proposals/
/.agent-contexts/tf0109-relay-proposal.json
/.agent-contexts/tfp-2026-09-10-hints-lead.json
/.agent-contexts/tfp-2026-09-10-l1-source-gate.json
/packages/workbench/.agent-contexts/

# insta pending snapshots (generated by `cargo test`, resolved by `cargo insta review`)
*.pending-snap
.context/

# Nix/direnv
.direnv/
# workbench linked worktrees (dispatch outputs)
/worktrees/
# workbench runtime state (workbench.yaml + blackboard/checkpoints/events/locks)
/.workbench/
# nested task-forest written under packages/workbench when the CLI runs there
/packages/workbench/.agent-workbench/
# throwaway scratch scripts and export intermediates
/.agent-workbench/tmp/
/.tf-tmp/
# task-forest derived products stay out of history (TF-0147).
# canonical state is graph/ + config.json + events/events.jsonl; exports are
# rebuildable via `task_forest.py export`. Keep or back up local snapshots for
# history playback: compact audit events reference them rather than embed them.
# A fresh checkout can rebuild current state, not missing historical snapshots.
# Measured 2026-09-05: exports
# 109MB, snapshots 61MB against 864KB of canonical graph — GitHub was already
# returning GH001 large-file warnings on every push.
/.agent-workbench/task-forest/exports/
/.agent-workbench/task-forest/snapshots/
# local session work log — personal workspace memory, not repo history
/.workbuddy/memory/
# agent-kernel runtime state (session checkpoints, message blobs)
/.agent-kernel/
# WorkBuddy AI project data (session memory, logs)
/.workbuddy-ai/
