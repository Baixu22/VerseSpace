{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "helmor-app",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["run", "dev"],
			"port": 1420
		},
		{
			"name": "helmor-e2e-vite",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["run", "dev:e2e"],
			"port": 1430
		},
		{
			"name": "storybook",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["run", "storybook"],
			"port": 6006
		},
		{
			"name": "marketing",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["--cwd", "apps/marketing", "run", "dev"],
			"port": 3000
		},
		{
			"name": "workbench-api",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["packages/workbench/src/index.ts", "ui", "--port", "7700", "--no-open"],
			"port": 7700
		},
		{
			"name": "workbench-ui-acceptance",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["-e", "process.chdir('apps/workbench-ui'); await import('child_process').then(m=>m.spawn('bun',['run','dev','--','--port','5191'],{stdio:'inherit',shell:true}))"],
			"port": 5191
		},
		{
			"name": "workbench-ui",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["-e", "process.chdir('apps/workbench-ui'); await import('child_process').then(m=>m.spawn('bun',['run','dev'],{stdio:'inherit',shell:true}))"],
			"port": 5188
		}
	]
}
